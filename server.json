{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.youricp/mcp-server",
  "title": "YourICP",
  "description": "Enrich contacts by email or LinkedIn URL and build targeted B2B audiences.",
  "version": "0.1.3",
  "websiteUrl": "https://youricp.com/mcp",
  "repository": {
    "url": "https://github.com/YourICP/mcp-server",
    "source": "github",
    "id": "1333133986"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/YourICP/mcp-server/main/YourICP_Icon.png",
      "sizes": [
        "400x400"
      ],
      "mimeType": "image/png"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.youricp.com/sse"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@youricp/mcp",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "YOURICP_API_TOKEN",
          "description": "Your YourICP API token. Get one at https://app.youricp.com",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "YOURICP_API_URL",
          "description": "Base URL of the YourICP API (defaults to https://app.youricp.com)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
